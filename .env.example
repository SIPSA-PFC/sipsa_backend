# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Database
# SQLite — local testing, no Docker needed
DATABASE_URL=sqlite+aiosqlite:///./data/sipsa_test.db

# PostgreSQL — uncomment for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sipsa

# Auth — REQUIRED. A random string of at least 32 characters; the API, the
# ETL and Alembic refuse to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Trained models are found through the model_run table (python -m src.ml.train
# registers them), so no model path is configured here.
