# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# =============================================================================
# Environment & secrets
# =============================================================================
.env
.env.*
# Keep the example, never the real one. (gitignore has no inline comments:
# text after a pattern is part of the pattern, so this must be its own line.)
!.env.example

# =============================================================================
# Data — never commit raw source files or databases
# =============================================================================
# Ignore the folder *contents* (dir/*), not the folders (dir/): git cannot
# re-include a file whose parent directory is excluded, so the .gitkeep
# exceptions below only work with this form.
data/raw/*
data/models/*
data/processed/*
data/*.db

# Keep the folder structure but not the files
!data/raw/.gitkeep
!data/models/.gitkeep
!data/processed/.gitkeep

# =============================================================================
# ML outputs
# =============================================================================
outputs/
*.npz
*.h5
*.pt
*.ckpt
*.pb

# =============================================================================
# MATLAB source files (large binaries)
# =============================================================================
*.mat
*.m~

# =============================================================================
# Notebooks
# =============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

